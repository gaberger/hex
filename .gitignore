# Filesystem artifacts
Volumes/
# .hex is runtime state (at any depth) except the two committed root config files
**/.hex/*
!.hex/project.json
!.hex/project.yaml
.superset/
examples/hex-worktrees/
target/
examples/rust-api/target/
hex-hub/target/

# Example projects are isolated git repos — ignore their build artifacts and git state
examples/*/target/
examples/*/.git/
examples/sandbox-demo/target/

# Built binaries (use target/ or ~/.hex/bin/ instead)
bin/hex-agent
bin/hex-cli
bin/hex-nexus
bin/hex
bin/hex-chat

# Scratch / generated artifacts
tmp/
test-output/
*.tmp

# SpacetimeDB module lock files
spacetime-modules/*/Cargo.lock

# SpacetimeDB claude config
spacetime-modules/.claude/
tla2tools.jar
hexflo_TTrace_*.tla

# hex-graph knowledge-graph engine output
graph-out/
