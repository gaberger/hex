coverage/

# Logs
*.log
.hex-intf/

# Docs — local-only by default, but track the structured artifact dirs
docs/*
!docs/adrs/
!docs/workplans/
!docs/specs/
!docs/analysis/
!docs/examples/
!docs/guides/
!docs/algebra/
!docs/reference/
