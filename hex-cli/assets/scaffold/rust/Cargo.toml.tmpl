[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"

# Stand alone even when scaffolded inside another cargo workspace.
#
# Without this, `cargo` walks up, finds the enclosing workspace, and refuses to
# build: "current package believes it's in a workspace when it's not". The
# scaffold's own gate caught this the first time `hex scaffold --lang rust` ran
# inside this repository — a skeleton that cannot run is the thing the gate
# exists to prevent, and it would have failed for every user who scaffolds into
# a monorepo.
